# ─────────────────────────────────────────────────────────────────────────
# AGRILENS PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────
# Copy this to .env.local and fill in your actual values
# NEVER commit actual .env.local to git (add to .gitignore)
# ─────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION (REQUIRED)
# Get these from: https://app.supabase.com → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous public API key (safe to expose in frontend)
# Note: VITE_SUPABASE_ANON_KEY is public by design. Security is enforced via RLS policies.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY CONFIGURATION
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# ─────────────────────────────────────────────────────────────────────────

# Razorpay Key ID (public, safe to expose)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Enable test mode (set to false in production)
VITE_RAZORPAY_TEST_MODE=true

# ─────────────────────────────────────────────────────────────────────────
# QR CODE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# QR code generation service URL (uses qrserver.com by default)
VITE_QR_CODE_SERVICE_URL=https://api.qrserver.com/v1/create-qr-code

# ─────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────

VITE_ENABLE_FARMER_ID=true
VITE_ENABLE_SCHEMES=true
VITE_ENABLE_DISEASE_DETECTION=false
VITE_ENABLE_ESCROW_PAYMENTS=true

# ─────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────

VITE_RATE_LIMIT_LOGIN_ATTEMPTS=5
VITE_RATE_LIMIT_OTP_ATTEMPTS=3
VITE_RATE_LIMIT_API_CALLS=100

# ─────────────────────────────────────────────────────────────────────────
# SECURITY NOTES
# ─────────────────────────────────────────────────────────────────────────
# 1. Row Level Security (RLS) in supabase-schema-agrilens.sql protects your data
# 2. NEVER expose Razorpay Key Secret in frontend (backend only)
# 3. Always use HTTPS in production
# 4. Rotate credentials regularly
# 5. Use different keys for dev/staging/production
